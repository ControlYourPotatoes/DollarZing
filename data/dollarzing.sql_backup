--

DROP TABLE IF EXISTS `pool_players`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `pool_players` (
  `id` int NOT NULL AUTO_INCREMENT,
  `poolId` int NOT NULL,
  `userId` int NOT NULL,
  `serial` varchar(255) NOT NULL,
  `joinedAt` datetime NOT NULL,
  `status` enum('waiting','matched','left') DEFAULT 'waiting',
  `createdAt` datetime NOT NULL,
  `updatedAt` datetime NOT NULL,
  PRIMARY KEY (`id`),
  KEY `pool_players_user_id_status` (`userId`,`status`),
  KEY `pool_players_pool_id_status` (`poolId`,`status`),
  KEY `pool_players_user_id_pool_id` (`userId`,`poolId`),
