--
-- Table structure for table `users`
--

DROP TABLE IF EXISTS `users`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `users` (
  `id` int NOT NULL AUTO_INCREMENT,
  `firstName` varchar(255) DEFAULT NULL,
  `lastName` varchar(255) DEFAULT NULL,
  `email` varchar(255) NOT NULL,
  `dob` date DEFAULT NULL,
  `kyc_standard` varchar(255) DEFAULT 'N',
  `kyc_advanced` varchar(255) DEFAULT 'N',
  `password` varchar(255) NOT NULL,
  `charity` int DEFAULT '0',
  `charityPercent` float DEFAULT '10',
  `balance` float DEFAULT '0',
  `uuid_preventor` varchar(255) NOT NULL,
  `is_2fa` varchar(255) DEFAULT 'N',
  `referral_code` varchar(255) DEFAULT NULL,
  `activateCode` varchar(255) DEFAULT NULL,
  `recoveryCode` varchar(255) DEFAULT NULL,
  `recoveryCodeExpiry` datetime DEFAULT NULL,
  `createdAt` datetime DEFAULT NULL,
  `updatedAt` datetime DEFAULT NULL,
  `level` int DEFAULT '1',
  `currentSerial` varchar(255) DEFAULT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `email` (`email`),
  UNIQUE KEY `email_2` (`email`)
) ENGINE=InnoDB AUTO_INCREMENT=33 DEFAULT CHARSET=latin1;
/*!40101 SET character_set_client = @saved_cs_client */;

--
-- Dumping data for table `users`
--

LOCK TABLES `users` WRITE;
/*!40000 ALTER TABLE `users` DISABLE KEYS */;
