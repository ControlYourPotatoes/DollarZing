{
  "name": "DollarZing Full Development Environment",
  "build": {
    "dockerfile": "Dockerfile.dev",
    "context": ".."
  },
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "source=dollarzing-data,target=/data/datasets,type=volume"
  ],
  "ports": ["3001:3001", "3000:3000"],
  "environment": {
    "NODE_ENV": "development",
    "PORT": "3001",
    "LOG_LEVEL": "debug",
    "CODEX_UNSAFE_ALLOW_NO_SANDBOX": "true"
  },
  "runArgs": ["--cap-add=SYS_PTRACE", "--security-opt", "seccomp=unconfined"],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.vscode-typescript-next",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode",
        "ms-vscode.vscode-json",
        "ms-vscode.vscode-eslint",
        "ms-vscode.vscode-docker"
      ],
      "settings": {
        "typescript.preferences.includePackageJsonAutoImports": "on",
        "typescript.suggest.autoImports": true,
        "editor.formatOnSave": true,
        "editor.formatOnSaveTimeout": 5000,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "terminal.integrated.shell.linux": "/bin/bash"
      }
    }
  },
  "postCreateCommand": "cd /workspace && npm install && cd engine && npm ci",
  "remoteUser": "developer",
  "features": {}
}
